function rList(){const rows=S.trades.filter(t=>!q||JSON.stringify(t).toLowerCase().includes(q)).sort((a,b)=>(a[sortK]>b[sortK]?1:-1)*sortD||b.id-a.id);
const cols=[['date','Date'],['account','Acc'],['pair','Pair'],['tf','TF'],['strat','Strategy'],['rr','RR'],['did','Did'],['pnl','P&L'],['rule','Rule']];
$('#list').innerHTML=`<div class="card"><div class="row"><input id="q" placeholder="Search..." value="${esc(q)}"><span class="m">${rows.length} trades · net <b class="${cl(rows.reduce((a,t)=>a+t.pnl,0))}">${fm(rows.reduce((a,t)=>a+t.pnl,0))}</b></span></div></div>
<div class="card sc"><table><tr>${cols.map(c=>`<th data-k="${c[0]}">${c[1]}${sortK==c[0]?(sortD>0?' ▲':' ▼'):''}</th>`).join('')}<th></th></tr>${rows.map(t=>`<tr title="${esc(t.mnote||t.logic)}"><td>${t.date}</td><td>${esc(t.account)}</td><td>${esc(t.pair)}</td><td>${esc(t.tf)}</td><td>${esc((t.strat||[]).join(', '))}</td><td>${t.rr??'–'}</td><td>${esc(t.did)}</td><td class="${cl(t.pnl)}">${fm(t.pnl)}</td><td>${t.rule=='Yes'?'✔':t.rule=='No'?'✘':''}</td><td><button class="btn s" data-e="${t.id}">Edit</button> <button class="btn s" data-x="${t.id}">✕</button></td></tr>`).join('')}</table></div>`;
$('#q').oninput=e=>{q=e.target.value.toLowerCase();rList();const i=$('#q');i.focus();i.setSelectionRange(99,99)};
document.querySelectorAll('#list th[data-k]').forEach(h=>h.onclick=()=>{sortD=sortK==h.dataset.k?-sortD:-1;sortK=h.dataset.k;rList()});
document.querySelectorAll('[data-e]').forEach(b=>b.onclick=()=>{edit=b.dataset.e;show('add')});
document.querySelectorAll('[data-x]').forEach(b=>b.onclick=()=>{if(confirm('Delete this trade?')){S.trades=S.trades.filter(t=>t.id!=b.dataset.x);save();rList()}})}
// ---------- analysis
let flt={account:'',pair:'',from:'',to:''},dim='strat';
function stats(a){const n=a.length,w=a.filter(t=>t.pnl>0),l=a.filter(t=>t.pnl<0),gw=w.reduce((s,t)=>s+t.pnl,0),gl=-l.reduce((s,t)=>s+t.pnl,0),pnl=gw-gl;
let eq=0,pk=0,dd=0,ms=0,ml=0,cw=0,cL=0;[...a].sort((x,y)=>x.date>y.date?1:x.date<y.date?-1:x.id-y.id).forEach(t=>{eq+=t.pnl;pk=Math.max(pk,eq);dd=Math.max(dd,pk-eq);if(t.pnl>0){cw++;cL=0}else if(t.pnl<0){cL++;cw=0}else{cw=cL=0}ms=Math.max(ms,cw);ml=Math.max(ml,cL)});
const rs=a.filter(t=>t.r!=null);return{n,w:w.length,l:l.length,be:n-w.length-l.length,pnl,gw,gl,wr:n?w.length/n*100:0,pf:gl?gw/gl:gw?99:0,avg:n?pnl/n:0,aw:w.length?gw/w.length:0,al:l.length?-gl/l.length:0,dd,ms,ml,ar:rs.length?rs.reduce((s,t)=>s+t.r,0)/rs.length:null}}
const hr=t=>{const m=/(\d+):(\d+)\s*(am|pm)?/i.exec(t.time||'');if(!m)return null;let h=+m[1];if(m[3]&&m[3].toLowerCase()=='pm'&&h<12)h+=12;if(!m[3]&&h<12&&h>=5)h+=12;return h%24};
const DIMS={account:['Account',t=>[t.account]],pair:['Pair',t=>[t.pair]],strat:['Strategy',t=>t.strat],htf:['HTF confirmation',t=>t.htf],tf:['Entry TF',t=>[t.tf]],session:['Session',t=>[t.session]],dir:['Direction',t=>[t.dir]],did:['What I did',t=>[t.did]],quick:['Quick view',t=>[t.quick]],mistake:['Mistake',t=>t.mistake],rule:['Rule followed',t=>[t.rule]],rr:['Planned RR',t=>[t.rr!=null?'1:'+Math.round(t.rr*2)/2:'']],wd:['Weekday',t=>['Sun Mon Tue Wed Thu Fri Sat'.split(' ')[new Date(t.date).getDay()]]],mo:['Month',t=>[t.date.slice(0,7)]],hr:['Entry hour',t=>[hr(t)==null?'':hr(t)+':00']]};
function grp(a,f){const m={};a.forEach(t=>(f(t)||[]).forEach(k=>{k=k||'(blank)';(m[k]=m[k]||[]).push(t)}));return Object.entries(m).map(([k,v])=>({k,...stats(v)})).sort((x,y)=>y.pnl-x.pnl)}
function tbl(rows){const mx=Math.max(1,...rows.map(r=>Math.abs(r.pnl)));return `<div class="sc"><table><tr><th>Name</th><th>Trades</th><th>Win%</th><th>P&amp;L</th><th></th><th>Avg</th><th>PF</th></tr>${rows.map(r=>`<tr><td>${esc(r.k)}</td><td>${r.n}</td><td>${r.wr.toFixed(0)}%</td><td class="${cl(r.pnl)}">${fm(r.pnl)}</td><td style="width:90px"><div class="bar" style="width:${Math.abs(r.pnl)/mx*80}px;background:var(--${r.pnl>=0?'g':'r'})"></div></td><td>${fm(r.avg)}</td><td>${r.pf.toFixed(2)}</td></tr>`).join('')}</table></div>`}
function rAna(){const a=S.trades.filter(t=>(!flt.account||t.account==flt.account)&&(!flt.pair||t.pair==flt.pair)&&(!flt.from||t.date>=flt.from)&&(!flt.to||t.date<=flt.to)),s=stats(a);
const sel=(k,l)=>`<div><label>${l}</label><select data-f="${k}"><option value="">All</option>${opts(k).map(o=>`<option ${flt[k]==o?'selected':''}>${esc(o)}</option>`).join('')}</select></div>`;
const K=(l,v,c='')=>`<div class="kpi"><small>${l}</small><b class="${c}">${v}</b></div>`;
const sorted=[...a].sort((x,y)=>x.date>y.date?1:x.date<y.date?-1:x.id-y.id);
// after-loss
const al=[0,1,2,3].map(k=>{const r=[];let c=0;sorted.forEach(t=>{if(c==k)r.push(t);c=t.pnl<0?c+1:0});return{k:k?'After '+k+' loss'+(k>1?'es':'')+(k==3?'+':''):'After win/start',...stats(r)}}).filter(x=>x.n);
const days={};a.forEach(t=>(days[t.date]=days[t.date]||[]).push(t));const tpd=Object.values(days);
const nb=[1,2,3,4].map(k=>{const r=tpd.filter(d=>k<4?d.length==k:d.length>=4).flat();return{k:k<4?k+' trade'+(k>1?'s':'')+'/day':'4+/day',...stats(r)}}).filter(x=>x.n);
const wi=a.filter(t=>t.whatif!=null),wis=wi.reduce((x,t)=>x+t.whatif,0),wia=wi.reduce((x,t)=>x+t.pnl,0);
const rf=grp(a,t=>[t.rule||'(blank)']);
$('#ana').innerHTML=`<div class="card"><div class="row">${sel('account','Account')}${sel('pair','Pair')}<div><label>From</label><input type="date" data-f="from" value="${flt.from}"></div><div><label>To</label><input type="date" data-f="to" value="${flt.to}"></div></div></div>
<div class="grid" style="margin-bottom:12px">${K('Net P&L',fm(s.pnl),cl(s.pnl))}${K('Trades',s.n)}${K('Win rate',s.wr.toFixed(1)+'%')}${K('Profit factor',s.pf.toFixed(2))}${K('Expectancy / trade',fm(s.avg),cl(s.avg))}${K('Avg win',fm(s.aw),'g')}${K('Avg loss',fm(s.al),'r')}${K('Win : Loss (W/L/BE)',s.w+' / '+s.l+' / '+s.be)}${K('Max drawdown',fm(-s.dd),'r')}${K('Max win streak',s.ms)}${K('Max loss streak',s.ml)}${K('Avg R',s.ar==null?'–':s.ar.toFixed(2))}</div>
<div class="card"><h3>Equity curve</h3><canvas id="eq"></canvas></div>
<div class="card"><div class="row"><h3 style="flex:2">Breakdown by</h3><select id="dim">${Object.entries(DIMS).map(([k,v])=>`<option value="${k}" ${dim==k?'selected':''}>${v[0]}</option>`).join('')}</select></div>${tbl(grp(a,DIMS[dim][1]))}</div>
<div class="card"><h3>Exit study: what I did vs what-if</h3>${tbl(grp(a,DIMS.did[1]))}${wi.length?`<p class="m">${wi.length} trades have a what-if value: actual <b class="${cl(wia)}">${fm(wia)}</b> vs what-if <b class="${cl(wis)}">${fm(wis)}</b> → difference <b class="${cl(wis-wia)}">${fm(wis-wia)}</b></p>`:'<p class="m">Fill “What-if result ($)” on trades to compare trail / early exit with the plan.</p>'}</div>
<div class="card"><h3>Behaviour: next trade after losses</h3>${tbl(al)}<h3 style="margin-top:12px">Overtrading: trades per day</h3>${tbl(nb)}<h3 style="margin-top:12px">Rule followed vs broken</h3>${tbl(rf)}</div>
<div class="card"><h3>Calendar (daily P&amp;L)</h3><div id="cal"></div></div>`;
document.querySelectorAll('#ana [data-f]').forEach(e=>e.onchange=()=>{flt[e.dataset.f]=e.value;rAna()});$('#dim').onchange=e=>{dim=e.target.value;rAna()};
// calendar
const mo={};Object.entries(days).forEach(([d,v])=>{(mo[d.slice(0,7)]=mo[d.slice(0,7)]||[]).push([d,v.reduce((x,t)=>x+t.pnl,0)])});
const mxd=Math.max(1,...Object.values(days).map(v=>Math.abs(v.reduce((x,t)=>x+t.pnl,0))));
$('#cal').innerHTML=Object.keys(mo).sort().map(m=>`<div style="margin-bottom:8px"><label>${m} · ${fm(mo[m].reduce((x,y)=>x+y[1],0))}</label><div class="cal">${mo[m].sort().map(([d,p])=>`<div class="cd" title="${d}: ${fm(p)}" style="background:${p>0?'var(--g)':p<0?'var(--r)':'var(--mu)'};opacity:${.35+.65*Math.abs(p)/mxd}">${+d.slice(8)}</div>`).join('')}</div></div>`).join('');
// equity
const c=$('#eq'),x=c.getContext('2d'),W=c.width=c.clientWidth*2,H=c.height=440;let e=0;const pts=sorted.map(t=>e+=t.pnl);
if(pts.length){const mn=Math.min(0,...pts),mx2=Math.max(0,...pts),sy=v=>H-30-(v-mn)/((mx2-mn)||1)*(H-60),sx=i=>20+i/Math.max(1,pts.length-1)*(W-40),st=getComputedStyle(document.body);
x.strokeStyle=st.getPropertyValue('--bd');x.lineWidth=2;x.beginPath();x.moveTo(0,sy(0));x.lineTo(W,sy(0));x.stroke();x.strokeStyle=st.getPropertyValue('--ac');x.lineWidth=3;x.beginPath();pts.forEach((v,i)=>i?x.lineTo(sx(i),sy(v)):x.moveTo(sx(i),sy(v)));x.stroke();
x.fillStyle=st.getPropertyValue('--mu');x.font='24px sans-serif';x.fillText(fm(mx2),24,22);x.fillText(fm(mn),24,H-6)}}
// ---------- data / backup
function csv(){const q=v=>'"'+String(v??'').replace(/"/g,'""')+'"';return F.join(',')+'\n'+S.trades.map(t=>F.map(k=>q(ARR.includes(k)?(t[k]||[]).join('|'):t[k])).join(',')).join('\n')}
function parseCsv(s){const r=[];let row=[],f='',q=false;for(let i=0;i<s.length;i++){const c=s[i];if(q){if(c=='"'){if(s[i+1]=='"'){f+='"';i++}else q=false}else f+=c}else if(c=='"')q=true;else if(c==','){row.push(f);f=''}else if(c=='\n'||c=='\r'){if(c=='\r'&&s[i+1]=='\n')i++;row.push(f);f='';if(row.length>1||row[0])r.push(row);row=[]}else f+=c}if(f||row.length){row.push(f);r.push(row)}return r}
function dl(n,t,m){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([t],{type:m}));a.download=n;a.click()}
async function push(q){const el=$('#st');try{await fetch(S.url,{method:'POST',mode:'no-cors',body:JSON.stringify({trades:S.trades,fields:F})});S.t=Date.now();localStorage.setItem(KEY,JSON.stringify(S));if(el)el.textContent='✔ Sheet backup sent '+new Date().toLocaleTimeString()}catch(e){if(el)el.textContent='✘ Backup failed (offline?). Data is safe in this browser.'}}
function rData(){$('#data').innerHTML=`<div class="card"><h3>Backup to Google Sheet (automatic)</h3><p class="m">Paste your Apps Script Web App URL once. After that every save is sent to your Sheet automatically.</p><div class="row"><input id="url" placeholder="https://script.google.com/macros/s/.../exec" value="${esc(S.url)}"><button class="btn" id="su">Save URL</button><button class="btn s" id="pn">Backup now</button><button class="btn s" id="rs">Restore from Sheet</button></div><p id="st" class="m">${S.t?'Last backup: '+new Date(S.t).toLocaleString():'Not backed up yet'}</p></div>
<div class="card"><h3>Excel / CSV</h3><div class="row"><button class="btn" id="ex">Export CSV (opens in Excel)</button><button class="btn s" id="ej">Export JSON</button><div><label>Import CSV / JSON (replaces all data)</label><input type="file" id="im" accept=".csv,.json"></div></div><p class="m">Total trades stored: ${S.trades.length}. Export now and then as an extra safety copy.</p></div>
<div class="card"><h3>Danger zone</h3><button class="btn d" id="wp">Delete all trades</button></div>`;
$('#su').onclick=()=>{S.url=$('#url').value.trim();save();alert('Saved')};$('#pn').onclick=()=>{if(!S.url)return alert('Add the URL first');push()};
$('#rs').onclick=async()=>{if(!S.url||!confirm('Replace local data with the Sheet data?'))return;try{const j=await(await fetch(S.url)).json();if(j.trades){S.trades=j.trades;save();alert('Restored '+j.trades.length+' trades');rData()}}catch(e){alert('Could not read the Sheet')}};
$('#ex').onclick=()=>dl('trading-journal.csv','\ufeff'+csv(),'text/csv');$('#ej').onclick=()=>dl('trading-journal.json',JSON.stringify(S.trades),'application/json');
$('#wp').onclick=()=>{if(confirm('Delete ALL trades? Export first!')){S.trades=[];save();rData()}};
$('#im').onchange=e=>{const f=e.target.files[0];if(!f)return;const rd=new FileReader();rd.onload=()=>{try{let t;if(f.name.endsWith('.json'))t=JSON.parse(rd.result);else{const r=parseCsv(rd.result.replace(/^\ufeff/,'')),h=r[0];t=r.slice(1).map(c=>{const o={};h.forEach((k,i)=>{const v=c[i];o[k]=ARR.includes(k)?(v?v.split('|'):[]):NUM.includes(k)||k=='id'?(v===''||v==null?null:+v):v});return o})}
if(!confirm('Replace current '+S.trades.length+' trades with '+t.length+' imported trades?'))return;S.trades=t.map((o,i)=>({...o,id:o.id||i+1}));save();alert('Imported '+t.length);rData()}catch(x){alert('Import failed: '+x.message)}};rd.readAsText(f)}}
rAdd();
</script></body></html>
